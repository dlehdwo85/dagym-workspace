{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["icn1"],
  "buildCommand": "node scripts/migrate.mjs && next build",
  "ignoreCommand": "bash scripts/vercel-ignore.sh",
  "crons": [{ "path": "/api/cron/tick", "schedule": "0 0 * * *" }],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "claude/**": false,
      "local/**": false
    }
  }
}
