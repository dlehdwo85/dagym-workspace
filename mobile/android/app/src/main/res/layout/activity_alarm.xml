<?xml version="1.0" encoding="utf-8"?>
<!-- 1.1.3 전체화면 알람 화면: 워크인 초록 바탕, 시각·제목, 큰 [해제]·[n분 뒤] -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/workin_notification"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="72dp"
    android:paddingEnd="28dp"
    android:paddingBottom="40dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="워크인 알람"
        android:textColor="#CCFFFFFF"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/alarm_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#FFFFFF"
        android:textSize="52sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alarm_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:maxLines="3"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alarm_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:maxLines="4"
        android:textColor="#E6FFFFFF"
        android:textSize="16sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/alarm_dismiss"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:backgroundTint="#FFFFFF"
        android:text="해제"
        android:textColor="@color/workin_notification"
        android:textSize="22sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/alarm_snooze"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#14524D"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/alarm_open"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="12dp"
        android:text="워크인에서 열기 ›"
        android:textColor="#FFFFFF"
        android:textSize="15sp" />
</LinearLayout>
