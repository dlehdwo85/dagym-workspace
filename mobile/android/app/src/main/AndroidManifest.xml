<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 딥링크: workos://tasks/<id> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="workos" />
            </intent-filter>

            <!-- 앱 링크: 운영 주소의 /tasks·/calendar·/notifications·/messages·/projects 링크를 앱에서 연다 (assetlinks.json 검증) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${appHost}" android:pathPrefix="/tasks" />
                <data android:scheme="https" android:host="${appHost}" android:pathPrefix="/calendar" />
                <data android:scheme="https" android:host="${appHost}" android:pathPrefix="/notifications" />
                <data android:scheme="https" android:host="${appHost}" android:pathPrefix="/messages" />
                <data android:scheme="https" android:host="${appHost}" android:pathPrefix="/projects" />
            </intent-filter>
        </activity>

        <!-- FCM 알림 기본 아이콘·색(앱이 꺼져 있을 때 시스템이 그리는 알림) -->
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_stat_workin" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/workin_notification" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="work" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 알람 진동(앱 안 알람 띠·알람 채널 alarm_vibrate) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 음성 등록·AI 비서 음성 입력: 마이크 + 휴대폰 음성 인식 서비스(Android 11+ 는 queries 로 서비스 조회 허용) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
    <!-- 휴대폰 예약 알림(일정·마감 n분 전)을 정확한 시각에: 캘린더 앱은 USE_EXACT_ALARM 허용(Android 13+), 12 이하는 SCHEDULE_EXACT_ALARM -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
