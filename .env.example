# 필수
DATABASE_URL=postgres://user:pass@host:5432/db
APP_URL=http://localhost:3000
# 32바이트 이상 임의 문자열 (토큰 암호화·서명)
APP_SECRET=change-me-to-a-long-random-string
# 최초 대표 계정 생성용 1회성 비밀값 (/setup). 생성 후 비워도 됨
SETUP_SECRET=

# 파일 저장소 (S3 호환: Cloudflare R2 / Supabase Storage / AWS S3). 비우면 로컬 디스크(.data/uploads) 사용
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# 스케줄러 (GitHub Actions OIDC). 저장소 이름: owner/repo
SCHEDULER_REPO=dlehdwo85/dagym-workspace
# 수동 호출용 비밀값 (선택)
CRON_SECRET=

# 웹 푸시 (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# 앱 푸시 (Firebase Cloud Messaging HTTP v1) - 서비스 계정 JSON 전체를 한 줄로
FCM_SERVICE_ACCOUNT_JSON=

# Google Calendar 연동
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 테스트용 가짜 Google API 주소 (운영에서는 비움)
GOOGLE_API_BASE=
GOOGLE_OAUTH_BASE=
