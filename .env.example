# 필수
DATABASE_URL=postgres://user:pass@host:5432/db
APP_URL=http://localhost:3000
# 32바이트 이상 임의 문자열 (토큰 암호화·서명)
APP_SECRET=change-me-to-a-long-random-string
# 최초 대표 계정 생성용 1회성 비밀값 (/setup). 생성 후 비워도 됨
SETUP_SECRET=

# 파일 저장소 (S3 호환: Cloudflare R2 / Supabase Storage / AWS S3). 비우면 로컬 디스크(.data/uploads) 사용
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# 스케줄러 (GitHub Actions OIDC). 저장소 이름: owner/repo
SCHEDULER_REPO=dlehdwo85/dagym-workspace
# 수동 호출용 비밀값 (선택)
CRON_SECRET=

# 웹 푸시 (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# 앱 푸시 (Firebase Cloud Messaging HTTP v1) - 서비스 계정 JSON 전체를 한 줄로
FCM_SERVICE_ACCOUNT_JSON=

# [선택 기능] Google Calendar 동기화 — 기본 꺼짐. 켜려면 1 과 아래 OAuth 값 모두 필요
FEATURE_GOOGLE_SYNC=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 테스트용 가짜 Google API 주소 (운영에서는 비움)
GOOGLE_API_BASE=
GOOGLE_OAUTH_BASE=

# [V9 AI 비서] 플랫폼(워크인) 계정의 Anthropic API 키 — 없으면 AI 메뉴 전체 숨김. 값은 Vercel 에만 넣는다
ANTHROPIC_API_KEY=
# 모델: AI_MODEL 기본(AI 비서, 기본 claude-sonnet-5-5) · AI_MODEL_FAST 가벼운 작업(기본 claude-haiku-5-5) · AI_MODEL_DEEP 매출 분석(기본 claude-opus-5-5)
# · 생각 깊이(low/medium/high, 기본 medium) · 회사별 월 한도 기본값(달러, 기본 30)
AI_MODEL=
AI_MODEL_FAST=
AI_MODEL_DEEP=
AI_EFFORT=
AI_MONTHLY_BUDGET_USD=

# [마케팅 · Meta 앱] 게시 채널·광고 성과·리드 광고 연결 — 값은 Vercel 에만 넣는다
META_APP_ID=
META_APP_SECRET=
# 리드 광고 웹후크 확인 토큰(아무 긴 문자열) — 같은 값을 Meta 앱 대시보드 › 웹후크(Page, leadgen) 확인 토큰에도
META_WEBHOOK_VERIFY_TOKEN=

# [영업 · 지원사업(#450)] 원천 인증키 — 플랫폼 운영 › 영업 수집기 설정에 넣어도 됨(넣은 값이 우선, 암호화 저장). 값은 저장소에 쓰지 않는다
# 기업마당 지원사업정보 API crtfcKey(기업마당 '정책정보 개방 › 지원사업정보 API' 아래 'API 사용 신청')
BIZINFO_API_KEY=
# 공공데이터포털 serviceKey — 영업 수집기와 같은 키. K-Startup 사업공고(15125364)·기업마당 데이터(15157820)를 각각 활용신청
DATA_GO_KR_SERVICE_KEY=
